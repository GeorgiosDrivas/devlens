{
  "name": "@georgios-drivas/devlens",
  "version": "1.3.0",
  "description": "CLI tool that scans your project and generates an agent-friendly JSON manifest of your structure, entrypoints, stack, and environment.",
  "bin": {
    "devlens": "bin/devlens"
  },
  "scripts": {
    "start": "node bin/devlens",
    "test": "node --test",
    "format": "npx prettier --write .",
    "lint": "npx eslint . "
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "keywords": [
    "cli",
    "environment-variables",
    "agents",
    "project-scanner",
    "metadata",
    "developer-tools"
  ],
  "homepage": "https://github.com/GeorgiosDrivas/devlens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GeorgiosDrivas/devlens.git"
  },
  "bugs": {
    "url": "https://github.com/GeorgiosDrivas/devlens/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Georgios Drivas",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3"
  }
}
