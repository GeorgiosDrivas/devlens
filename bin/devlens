#!/usr/bin/env node

const fs = require("fs");
const path = require("path");
const { promises: fsp } = fs;

const root = process.cwd();

const JS_EXTS = new Set([".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs"]);
const SOURCE_EXTS = new Set([
  ".js",
  ".jsx",
  ".ts",
  ".tsx",
  ".mjs",
  ".cjs",
  ".json",
  ".md",
  ".mdx",
  ".prisma",
]);

const IGNORED_DIRS = new Set([
  "node_modules",
  ".git",
  ".devlens",
  ".next",
  "dist",
  "build",
  "coverage",
  ".turbo",
  ".vercel",
  "out",
]);

const IGNORED_PATH_SEGMENTS = [
  "generated",
  "src/generated",
  "prisma/generated",
];

async function pathExists(p) {
  try {
    await fsp.access(p);
    return true;
  } catch {
    return false;
  }
}

async function readJson(filePath) {
  try {
    const raw = await fsp.readFile(filePath, "utf8");
    return JSON.parse(raw);
  } catch {
    return null;
  }
}

function normalizeSlashes(value) {
  return value.replace(/\\/g, "/");
}

function toRelative(filePath) {
  return normalizeSlashes(path.relative(root, filePath));
}

function isIgnoredPath(fullPath) {
  const relative = toRelative(fullPath);
  const parts = relative.split("/");

  if (parts.some((part) => IGNORED_DIRS.has(part))) {
    return true;
  }

  return IGNORED_PATH_SEGMENTS.some(
    (segment) => relative === segment || relative.startsWith(`${segment}/`),
  );
}

async function walk(dir, filter) {
  const results = [];
  const entries = await fsp.readdir(dir, { withFileTypes: true });

  for (const entry of entries) {
    const full = path.join(dir, entry.name);

    if (entry.isDirectory()) {
      if (IGNORED_DIRS.has(entry.name)) continue;
      if (isIgnoredPath(full)) continue;
      results.push(...(await walk(full, filter)));
      continue;
    }

    if (isIgnoredPath(full)) continue;
    if (!filter || filter(full)) {
      results.push(full);
    }
  }

  return results;
}

async function findFirstExistingPath(candidates) {
  for (const candidate of candidates) {
    if (await pathExists(candidate)) {
      return candidate;
    }
  }
  return null;
}

async function detectFramework(packageJson, hasAppDir, hasPagesDir) {
  const deps = packageJson?.dependencies || {};
  const devDeps = packageJson?.devDependencies || {};
  const evidence = [];

  if (deps.next || devDeps.next) {
    return {
      name: "nextjs",
      confidence: 0.98,
      evidence: ["package.json dependency: next"],
    };
  }

  if (hasAppDir) {
    return {
      name: "nextjs",
      confidence: 0.76,
      evidence: ["app directory found"],
    };
  }

  if (hasPagesDir) {
    return {
      name: "nextjs",
      confidence: 0.7,
      evidence: ["pages directory found"],
    };
  }

  let reactScore = 0;

  if (deps.react || devDeps.react) {
    reactScore += 0.35;
    evidence.push("package.json dependency: react");
  }

  if (deps["react-dom"] || devDeps["react-dom"]) {
    reactScore += 0.25;
    evidence.push("package.json dependency: react-dom");
  }

  if (
    (await pathExists(path.join(root, "src", "main.jsx"))) ||
    (await pathExists(path.join(root, "src", "main.tsx"))) ||
    (await pathExists(path.join(root, "src", "index.jsx"))) ||
    (await pathExists(path.join(root, "src", "index.tsx")))
  ) {
    reactScore += 0.2;
    evidence.push("React entry file found");
  }

  if (await pathExists(path.join(root, "index.html"))) {
    reactScore += 0.1;
    evidence.push("index.html found");
  }

  if (deps.vite || devDeps.vite) {
    reactScore += 0.1;
    evidence.push("package.json dependency: vite");
  }

  if (reactScore > 0) {
    return {
      name: "react",
      confidence: Math.min(0.95, Number(reactScore.toFixed(2))),
      evidence,
    };
  }

  return {
    name: "unknown",
    confidence: 0,
    evidence: [],
  };
}

async function collectEnvFromDotFiles(files) {
  const envVars = {};

  for (const file of files) {
    const content = await fsp.readFile(file, "utf8");

    for (const line of content.split(/\r?\n/)) {
      const noComment = line.split("#")[0].trim();
      if (!noComment) continue;

      const eq = noComment.indexOf("=");
      if (eq <= 0) continue;

      const name = noComment.slice(0, eq).trim();
      if (!name) continue;

      if (!envVars[name]) {
        envVars[name] = [];
      }

      envVars[name].push(toRelative(file));
    }
  }

  return envVars;
}

function findEnvReferencesInText(text) {
  const used = new Set();

  const patterns = [
    /process\.env\.([A-Za-z_][A-Za-z0-9_]*)/g,
    /import\.meta\.env\.([A-Za-z_][A-Za-z0-9_]*)/g,
    /process\.env\s*\[\s*['"`]([A-Za-z_][A-Za-z0-9_]*)['"`]\s*\]/g,
    /import\.meta\.env\s*\[\s*['"`]([A-Za-z_][A-Za-z0-9_]*)['"`]\s*\]/g,
  ];

  for (const pattern of patterns) {
    let match;
    while ((match = pattern.exec(text)) !== null) {
      used.add(match[1]);
    }
  }

  return Array.from(used);
}

function getRoutePathFromAppFile(appRoot, file) {
  const relative = normalizeSlashes(path.relative(appRoot, file));
  if (!relative) return null;
  if (relative.startsWith("api/")) return null;

  const noExt = relative.replace(/\.[^.]+$/, "");

  if (!(noExt === "page" || noExt.endsWith("/page"))) {
    return null;
  }

  const routeBase = noExt.replace(/\/page$/, "").replace(/^page$/, "");
  const route = routeBase ? `/${routeBase}` : "/";

  return route.replace(/\/+/g, "/");
}

function getApiRouteFromAppFile(appRoot, file) {
  const relative = normalizeSlashes(path.relative(appRoot, file));
  if (!relative.startsWith("api/")) return null;

  const noExt = relative.replace(/\.[^.]+$/, "");

  if (!(noExt === "api/route" || noExt.endsWith("/route"))) {
    return null;
  }

  const routeBase = noExt
    .replace(/^api/, "")
    .replace(/\/route$/, "")
    .replace(/^$/, "");

  const route = `/api${routeBase}`;

  return route.replace(/\/+/g, "/");
}

function deriveRouteFromPagesFile(pagesRoot, file) {
  const relative = normalizeSlashes(path.relative(pagesRoot, file));
  if (!relative || relative.startsWith("api/")) return null;

  const noExt = relative.replace(/\.[^.]+$/, "");

  if (noExt === "_app" || noExt === "_document" || noExt === "_error") {
    return null;
  }

  if (noExt === "index") return "/";
  if (noExt.endsWith("/index")) {
    return `/${noExt.replace(/\/index$/, "")}`.replace(/\/+/g, "/");
  }

  return `/${noExt}`.replace(/\/+/g, "/");
}

function deriveApiRouteFromPagesFile(pagesRoot, file) {
  const relative = normalizeSlashes(path.relative(pagesRoot, file));
  if (!relative.startsWith("api/")) return null;

  const noExt = relative.replace(/\.[^.]+$/, "");
  return `/${noExt}`.replace(/\/+/g, "/");
}

function extractMethodsFromFileText(text) {
  const methods = new Set();

  const exportPattern =
    /export\s+(?:async\s+)?function\s+(GET|POST|PUT|PATCH|DELETE|OPTIONS|HEAD)\b|export\s+const\s+(GET|POST|PUT|PATCH|DELETE|OPTIONS|HEAD)\b/gi;

  let match;
  while ((match = exportPattern.exec(text)) !== null) {
    const method = match[1] || match[2];
    if (method) methods.add(method.toUpperCase());
  }

  return Array.from(methods).sort();
}

function uniqueBy(items, keyFn) {
  const seen = new Set();
  const output = [];

  for (const item of items) {
    const key = keyFn(item);
    if (seen.has(key)) continue;
    seen.add(key);
    output.push(item);
  }

  return output;
}

async function scanRoutes(appDir, pagesDir) {
  const routes = [];
  const apiRoutes = [];

  if (appDir) {
    const appFiles = await walk(appDir, (file) =>
      JS_EXTS.has(path.extname(file).toLowerCase()),
    );

    for (const file of appFiles) {
      const route = getRoutePathFromAppFile(appDir, file);
      const apiRoute = getApiRouteFromAppFile(appDir, file);
      const relativeFile = toRelative(file);

      if (route) {
        routes.push({
          path: route,
          file: relativeFile,
          type: "page",
        });
      }

      if (apiRoute) {
        const text = await fsp.readFile(file, "utf8");
        const methods = extractMethodsFromFileText(text);

        apiRoutes.push({
          path: apiRoute,
          file: relativeFile,
          methods: methods.length ? methods : ["GET", "POST"],
        });
      }
    }
  }

  if (pagesDir) {
    const pageFiles = await walk(pagesDir, (file) =>
      JS_EXTS.has(path.extname(file).toLowerCase()),
    );

    for (const file of pageFiles) {
      const relativeFile = toRelative(file);
      const relativeToPages = normalizeSlashes(path.relative(pagesDir, file));

      if (relativeToPages.startsWith("api/")) {
        const apiRoute = deriveApiRouteFromPagesFile(pagesDir, file);

        if (apiRoute) {
          const text = await fsp.readFile(file, "utf8");
          const methods = extractMethodsFromFileText(text);

          apiRoutes.push({
            path: apiRoute,
            file: relativeFile,
            methods: methods.length ? methods : ["GET", "POST"],
          });
        }
      } else {
        const route = deriveRouteFromPagesFile(pagesDir, file);

        if (route) {
          routes.push({
            path: route,
            file: relativeFile,
            type: "page",
          });
        }
      }
    }
  }

  return {
    routes: uniqueBy(
      routes.sort(
        (a, b) => a.path.localeCompare(b.path) || a.file.localeCompare(b.file),
      ),
      (item) => `${item.path}::${item.file}`,
    ),
    apiRoutes: uniqueBy(
      apiRoutes.sort(
        (a, b) => a.path.localeCompare(b.path) || a.file.localeCompare(b.file),
      ),
      (item) => `${item.path}::${item.file}`,
    ),
  };
}

async function scanEnv() {
  const dotCandidates = [
    ".env",
    ".env.local",
    ".env.development",
    ".env.production",
    ".env.test",
  ];

  const envFiles = [];
  for (const envFile of dotCandidates) {
    const full = path.join(root, envFile);
    if (await pathExists(full)) {
      envFiles.push(full);
    }
  }

  const declaredEnv = await collectEnvFromDotFiles(envFiles);

  const allSourceFiles = await walk(root, (file) => {
    const ext = path.extname(file).toLowerCase();
    return SOURCE_EXTS.has(ext);
  });

  const referencedEnv = {};

  for (const file of allSourceFiles) {
    const text = await fsp.readFile(file, "utf8");
    const keys = findEnvReferencesInText(text);

    for (const key of keys) {
      if (!referencedEnv[key]) {
        referencedEnv[key] = new Set();
      }
      referencedEnv[key].add(toRelative(file));
    }
  }

  const used = [];
  const unused = [];
  const missing = [];

  for (const [name, files] of Object.entries(referencedEnv)) {
    if (declaredEnv[name]) {
      used.push({
        name,
        files: Array.from(files).sort(),
      });
    } else {
      missing.push({
        name,
        referencedIn: Array.from(files).sort(),
      });
    }
  }

  for (const [name, filePaths] of Object.entries(declaredEnv)) {
    if (!referencedEnv[name]) {
      unused.push({
        name,
        declaredIn: Array.from(new Set(filePaths)).sort(),
      });
    }
  }

  return {
    used: used.sort((a, b) => a.name.localeCompare(b.name)),
    unused: unused.sort((a, b) => a.name.localeCompare(b.name)),
    missing: missing.sort((a, b) => a.name.localeCompare(b.name)),
  };
}

function hasEnvData(env) {
  return env.used.length > 0 || env.unused.length > 0 || env.missing.length > 0;
}

async function scanEnv() {
  const dotCandidates = [
    ".env",
    ".env.local",
    ".env.development",
    ".env.production",
    ".env.test",
  ];

  const envFiles = [];
  for (const envFile of dotCandidates) {
    const full = path.join(root, envFile);
    if (await pathExists(full)) {
      envFiles.push(full);
    }
  }

  const declaredEnv = await collectEnvFromDotFiles(envFiles);

  const allSourceFiles = await walk(root, (file) => {
    const ext = path.extname(file).toLowerCase();
    return SOURCE_EXTS.has(ext);
  });

  const referencedEnv = {};

  for (const file of allSourceFiles) {
    const text = await fsp.readFile(file, "utf8");
    const keys = findEnvReferencesInText(text);

    for (const key of keys) {
      if (!referencedEnv[key]) {
        referencedEnv[key] = new Set();
      }
      referencedEnv[key].add(toRelative(file));
    }
  }

  const used = [];
  const unused = [];
  const missing = [];

  for (const [name, files] of Object.entries(referencedEnv)) {
    if (declaredEnv[name]) {
      used.push({
        name,
        files: Array.from(files).sort(),
      });
    } else {
      missing.push({
        name,
        referencedIn: Array.from(files).sort(),
      });
    }
  }

  for (const [name, filePaths] of Object.entries(declaredEnv)) {
    if (!referencedEnv[name]) {
      unused.push({
        name,
        declaredIn: Array.from(new Set(filePaths)).sort(),
      });
    }
  }

  const env = {
    used: used.sort((a, b) => a.name.localeCompare(b.name)),
    unused: unused.sort((a, b) => a.name.localeCompare(b.name)),
    missing: missing.sort((a, b) => a.name.localeCompare(b.name)),
  };

  return hasEnvData(env) ? env : null;
}

async function scan() {
  const packageJson = (await readJson(path.join(root, "package.json"))) || {};
  const projectName = packageJson.name || path.basename(root) || "my-app";

  const appDir = await findFirstExistingPath([
    path.join(root, "app"),
    path.join(root, "src", "app"),
  ]);

  const pagesDir = await findFirstExistingPath([
    path.join(root, "pages"),
    path.join(root, "src", "pages"),
  ]);

  const framework = await detectFramework(packageJson, !!appDir, !!pagesDir);
  const { routes, apiRoutes } = await scanRoutes(appDir, pagesDir);
  const env = await scanEnv();

  const result = {
    project: {
      name: projectName,
      root: ".",
      framework,
    },
  };

  if (routes.length > 0) {
    result.routes = routes;
  }

  if (apiRoutes.length > 0) {
    result.apiRoutes = apiRoutes;
  }

  if (env) {
    result.env = env;
  }

  return result;
}

async function ensureDevLensDir() {
  const target = path.join(root, ".devlens");
  await fsp.mkdir(target, { recursive: true });
  return target;
}

async function runInit() {
  const result = await scan();
  await ensureDevLensDir();

  const outputFile = path.join(root, ".devlens", "devlens.json");
  await fsp.writeFile(outputFile, JSON.stringify(result, null, 2), "utf8");

  console.log(`Written ${outputFile}`);
}

function printHelp() {
  console.log("Run `devlens init` to generate .devlens/devlens.json");
}

async function main() {
  const args = process.argv.slice(2);
  const command = args[0];

  if (command === "help" || command === "--help" || command === "-h") {
    console.log("Usage: devlens [command]\n");
    console.log("Commands:");
    console.log("  init     Generate .devlens/devlens.json");
    console.log('\nIf no command is provided, "init" is used by default.');
    process.exit(0);
  }

  if (!command || command === "init") {
    try {
      await runInit();
      process.exit(0);
    } catch (err) {
      console.error("error:", err?.message || err);
      process.exit(1);
    }
  }

  console.error(`Unknown command: ${command}`);
  process.exit(1);
}

main();
